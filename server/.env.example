# MongoDB connection string (application data: users, progress, curriculum metadata)
MONGODB_URI=mongodb://localhost:27017/sqlprep

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Where the React app runs — used for CORS and post-login redirects
CLIENT_URL=http://localhost:5173

# Server
PORT=5000
NODE_ENV=development

# Set to "true" behind a reverse proxy that terminates HTTPS (Heroku, Render, nginx+TLS, etc.)
# so Express trusts X-Forwarded-* headers and secure cookies work correctly.
TRUST_PROXY=false
